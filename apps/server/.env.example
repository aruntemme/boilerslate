# Copy to .env (or run `bun run setup`, which generates the secret for you).
DATABASE_URL=postgresql://postgres:password@localhost:5433/boilerslate
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# --- AI ---------------------------------------------------------------
# Master key for the AI provider credentials stored per organization.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Provider API keys are NOT set here — they are configured per organization
# in Settings and stored encrypted. ENCRYPTION_KEY above is what protects them.

# Copy to .env (or run `bun run setup`, which generates the secret for you).
DATABASE_URL=postgresql://postgres:password@localhost:5433/boilerslate
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# --- AI ---------------------------------------------------------------
# Master key for provider credentials stored per organization through the
# settings UI. Generate with: openssl rand -base64 32
# Leave unset if you only ever configure providers by env var below.
ENCRYPTION_KEY=

# Fallback provider credentials, used when an organization has not stored
# its own key. Set only the providers you actually use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# For Ollama, vLLM, LM Studio, Groq, OpenRouter and similar:
COMPATIBLE_API_KEY=
COMPATIBLE_API_KEY_BASE_URL=

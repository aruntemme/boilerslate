{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"test": "bun test"
	},
	"dependencies": {
		"dotenv": "catalog:",
		"zod": "catalog:",
		"@boilerslate/env": "workspace:*",
		"@boilerslate/api": "workspace:*",
		"@boilerslate/auth": "workspace:*",
		"@boilerslate/db": "workspace:*",
		"hono": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"@boilerslate/ai": "workspace:*",
		"ai": "^7.0.79"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"tsdown": "^0.22.14",
		"@boilerslate/config": "workspace:*",
		"@types/bun": "catalog:"
	}
}
